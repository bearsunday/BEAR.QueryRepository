{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://bearsunday.github.io/BEAR.QueryRepository/schemas/context/save_state.json",
    "title": "save_state",
    "description": "Event: a resource state was stored in the cache (value body, rendered view, or donut view).",
    "type": "object",
    "required": [
        "uri",
        "tags",
        "ttl",
        "kind"
    ],
    "properties": {
        "uri": {
            "type": "string"
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "ttl": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0
        },
        "kind": {
            "type": "string",
            "enum": [
                "value",
                "view",
                "donut-view"
            ]
        }
    },
    "additionalProperties": false
}
