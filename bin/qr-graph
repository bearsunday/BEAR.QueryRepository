#!/usr/bin/env php
<?php

declare(strict_types=1);

use BEAR\QueryRepositoryGraph\Cli;

// The application's autoloader first: the resource classes to scan are the application's.
foreach ([getcwd() . '/vendor/autoload.php', __DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Cli())(array_slice($argv, 1), STDOUT, STDERR));
